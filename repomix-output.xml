<file path="ingestion/chunker.py">
import logging
import re

import spacy

from config.settings import Settings
from models.schemas import Chunk, ParsedDocument, SourceType

logger = logging.getLogger(__name__)

_nlp = None


def _get_nlp():
    global _nlp
    if _nlp is None:
        try:
            _nlp = spacy.load("en_core_web_sm")
        except OSError:
            logger.warning("spaCy model en_core_web_sm not found; using regex fallback")
            _nlp = None
    return _nlp


def _approx_tokens(text: str) -> int:
    return len(text.split())


class Chunker:
    def __init__(self, settings: Settings):
        self.chunk_size = settings.chunk_size
        self.chunk_overlap = settings.chunk_overlap
        self.chars_per_token = 4

    def split_document(
        self,
        doc: ParsedDocument,
        tenant_id: str,
        tags: list[str],
        raw_file_url: str,
    ) -> list[Chunk]:
        chunks: list[Chunk] = []
        chunk_index = 0

        for block in doc.blocks:
            if not block.text.strip():
                continue
            if doc.source_type in (SourceType.EXCEL, SourceType.CSV):
                chunks.append(
                    Chunk.new(
                        text=block.text,
                        tenant_id=tenant_id,
                        source_file=doc.source_file,
                        source_type=doc.source_type,
                        page_number=block.page_number,
                        tags=tags,
                        raw_file_url=raw_file_url,
                        chunk_index=chunk_index,
                    )
                )
                chunk_index += 1
            else:
                for text in self._split_text(block.text):
                    chunks.append(
                        Chunk.new(
                            text=text,
                            tenant_id=tenant_id,
                            source_file=doc.source_file,
                            source_type=doc.source_type,
                            page_number=block.page_number,
                            tags=tags,
                            raw_file_url=raw_file_url,
                            chunk_index=chunk_index,
                        )
                    )
                    chunk_index += 1
        return chunks

    def _split_text(self, text: str) -> list[str]:
        max_chars = self.chunk_size * self.chars_per_token
        overlap_chars = self.chunk_overlap * self.chars_per_token
        sentences = self._split_sentences(text)
        if not sentences:
            return [text] if text.strip() else []

        chunks: list[str] = []
        current: list[str] = []
        current_len = 0

        for sentence in sentences:
            sent_len = len(sentence)
            if current_len + sent_len > max_chars and current:
                chunks.append(" ".join(current))
                overlap_text = " ".join(current)
                if len(overlap_text) > overlap_chars:
                    overlap_text = overlap_text[-overlap_chars:]
                current = [overlap_text] if overlap_text else []
                current_len = len(overlap_text)

            current.append(sentence)
            current_len += sent_len + 1

        if current:
            chunks.append(" ".join(current))
        return chunks

    def _split_sentences(self, text: str) -> list[str]:
        nlp = _get_nlp()
        if nlp:
            doc = nlp(text)
            return [sent.text.strip() for sent in doc.sents if sent.text.strip()]
        return [s.strip() for s in re.split(r"(?<=[.!?])\s+", text) if s.strip()]
